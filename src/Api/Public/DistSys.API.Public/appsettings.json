{
  "AppName": "Api.Public",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "OrderWriteRoute": {
        "ClusterId": "OrderWriteCluster",
        "Match": {
          "Path": "order-ms/{**catch-all}",
          "Methods": [ "POST", "PUT" ]
        },
        "Transforms": [
          {
            "PathPattern": "{**catch-all}"
          }
        ]
      },
      "OrderReadRoute": {
        "ClusterId": "OrderReadCluster",
        "Match": {
          "Path": "order-ms/{**catch-all}",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          {
            "PathPattern": "{**catch-all}"
          }
        ]
      },
      "ProductRoute": {
        "ClusterId": "ProductCluster",
        "Match": {
          "Path": "product-ms/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "{**catch-all}"
          }
        ]
      }
    },
    "Clusters": {
      "OrderWriteCluster": {
        "Destinations": {
          "OrderWriteCluster/destination1": {
            "Address": "https://localhost:60220/"
          }
        }
      },
      "OrderReadCluster": {
        "Destinations": {
          "OrderReadCluster/destination1": {
            "Address": "https://localhost:60221/"
          }
        }
      },
      "ProductCluster": {
        "Destinations": {
          "ProductCluster/destination1": {
            "Address": "https://localhost:60320/"
          }
        }
      }
    }
  },
  "Bus": {
    "RabbitMQ": {
      "Publisher": {
        "IntegrationExchange": "api.public.exchange"
      }
    }
  },
  "Discovery": {
    "Address": "http://localhost:8500"
  },
  "AllowedHosts": "*"
}
